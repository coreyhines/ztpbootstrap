# ZTP Bootstrap - Image versions (single source of truth)
# Edit this file to update any image, then re-run installer or redeploy
NGINX_IMAGE=docker.io/nginx:1.30.2
POSTGRES_IMAGE=docker.io/library/postgres:17.10-alpine
WEBUI_IMAGE=registry.fedoraproject.org/fedora:44

# IMPORTANT: Kea version management
# ISC does not publish free public Kea container images. kea/Containerfile
# installs ISC's own packages (kea-3-0 LTS repo), pinned to the exact build
# below, and CI (.forgejo/workflows/kea-image.yml) builds and pushes
# KEA_IMAGE to hub.freeblizz.com when this file changes on main.
#
# To move Kea: set KEA_VERSION and KEA_PKG_RELEASE to a build ISC publishes
# (dnf repoquery against the ISC repo shows them), and give KEA_IMAGE the tag
# <KEA_VERSION>-<n>. Bump only <n> to rebuild the same Kea (new base image,
# security fixes). CI refuses a tag that does not start with KEA_VERSION or
# that already exists on the hub.
# This is the ONLY place to change the Kea version - do not edit elsewhere.
KEA_VERSION=3.0.4
KEA_PKG_RELEASE=isc20260728182757.fc44
KEA_IMAGE=hub.freeblizz.com/ztpbootstrap-kea:3.0.4-2
