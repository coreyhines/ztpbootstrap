# ZTP Bootstrap - Image versions (single source of truth)
# Edit this file to update any image, then re-run installer or redeploy
NGINX_IMAGE=docker.io/nginx:1.30.2
POSTGRES_IMAGE=docker.io/library/postgres:17.10-alpine
WEBUI_IMAGE=registry.fedoraproject.org/fedora:44

# IMPORTANT: Kea version management
# ISC does not publish free public Kea container images. Build from the
# project-provided Containerfile instead:
#   podman build -t ztpbootstrap-kea:3.0.3 -f kea/Containerfile .
# Then push to your registry and set KEA_IMAGE below.
# This is the ONLY place to change the Kea version - do not edit elsewhere.
KEA_IMAGE=ztpbootstrap-kea:3.0.3
