[Unit]
Description=ZTP Bootstrap PostgreSQL Database for Kea
After=network-online.target
Wants=network-online.target
# Cap automatic restarts: five starts in five minutes, then the unit stays
# failed instead of retrying forever. A fault that survives a restart should
# be visible as a failed unit, not hidden behind an endless restart loop.
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/library/postgres:17.10-alpine
ContainerName=ztpbootstrap-postgresql
Pod=ztpbootstrap.pod
Exec=/usr/local/bin/docker-entrypoint.sh postgres
Volume=/opt/containerdata/ztpbootstrap/postgresql:/var/lib/postgresql/data:rw
Environment=POSTGRES_DB=kea
Environment=POSTGRES_USER=kea
Environment=TZ=UTC
Environment=PGDATA=/var/lib/postgresql/data/pgdata
EnvironmentFile=-/opt/containerdata/ztpbootstrap/.env

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=ztpbootstrap-pod.service
