[Unit]
Description=ZTP Bootstrap Nginx Container
# Cap automatic restarts: five starts in five minutes, then the unit stays
# failed instead of retrying forever. A fault that survives a restart should
# be visible as a failed unit, not hidden behind an endless restart loop.
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
Image=docker.io/nginx:1.30.2
ContainerName=ztpbootstrap-nginx
Pod=ztpbootstrap.pod
Volume=/opt/containerdata/ztpbootstrap:/usr/share/nginx/html:ro
Volume=/opt/containerdata/ztpbootstrap/nginx.conf:/etc/nginx/conf.d/default.conf:ro
Volume=/opt/containerdata/certs/wild:/etc/nginx/ssl:ro
Volume=/opt/containerdata/ztpbootstrap/logs:/var/log/nginx:rw
Environment=TZ=UTC
HealthCmd=["/bin/sh", "-c", "test -s /run/nginx.pid && kill -0 $(cat /run/nginx.pid) 2>/dev/null"]
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=60s

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
