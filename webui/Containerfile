# Containerfile for building a Fedora-based image with Python, podman, and systemd
# This can be built locally: podman build -t ztpbootstrap-webui:local -f webui/Containerfile .
# Then update systemd/ztpbootstrap-webui.container to use: Image=ztpbootstrap-webui:local

FROM registry.fedoraproject.org/fedora:44
RUN dnf install -y -q python3 python3-pip podman systemd && dnf clean all
WORKDIR /app
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt
